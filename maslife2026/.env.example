# Copia este archivo como .env.local y rellena los valores reales
# NUNCA subas .env.local a GitHub

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...tu_anon_key
VITE_APP_URL=https://www.clinicamaslife.cl

# ── Notificaciones por email (Resend) ──────────────────────────────────────
# 1. Crea una cuenta gratuita en https://resend.com (3 000 emails/mes gratis)
# 2. Ve a resend.com/api-keys y crea una API Key
# 3. En Vercel: Settings → Environment Variables → agrega RESEND_API_KEY=re_xxxx
# 4. El endpoint /api/notify se despliega automáticamente con tu proyecto en Vercel
# VITE_RESEND_ENDPOINT=https://TU_DOMINIO.vercel.app/api/notify
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Clínica Maslife <notificaciones@tudominio.com>   ← opcional, dominio verificado en Resend

# ── Medición de campañas publicitarias (OPCIONAL) ──────────────────────────
# La analítica queda instalada pero "dormida" hasta que pegues estos IDs en Vercel.
# Sin ellos no se carga ningún píxel ni se envía nada (no-op, sin errores).
#   1. Meta Pixel:  business.facebook.com → Administrador de eventos → crear píxel
#   2. GA4:         analytics.google.com → Admin → Flujo de datos → ID de medición
#   3. Google Ads:  ads.google.com → Herramientas → Conversiones → etiqueta (AW-...)
# VITE_META_PIXEL_ID=1234567890
# VITE_GA4_ID=G-XXXXXXXXXX
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
