# Copia este archivo a .env.local (desarrollo) y carga los mismos valores en
# Vercel → Project → Settings → Environment Variables. Nunca lo subas a git.

# --- Meta / Instagram ---
# Token de PÁGINA (no caduca). Sácalo con: npm run token
IG_ACCESS_TOKEN=
# ID de la cuenta profesional de Instagram (instagram_business_account.id)
IG_USER_ID=
# ID de la página de Facebook Clínica mas Life
FB_PAGE_ID=106841074135065
GRAPH_API_VERSION=v23.0

# Secreto de la app (solo para validar la firma del webhook)
META_APP_SECRET=
# Texto que inventas tú y pegas también en Meta al configurar el webhook
WEBHOOK_VERIFY_TOKEN=

# --- Seguridad del MCP ---
# Clave larga y aleatoria. Genera una con: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
MCP_SECRET=
# Vercel la manda sola a los cron jobs si la defines
CRON_SECRET=

# --- Supabase ---
SUPABASE_URL=https://qhtfjbbdxtmqhstzkyrw.supabase.co
# Service role: solo en el servidor, nunca en el navegador
SUPABASE_SERVICE_ROLE_KEY=
